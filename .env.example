VITE_API_BASE_URL=http://localhost:4000

# Google Maps JS API key — enables Places autocomplete search and
# sector/street-level reverse geocoding (much better than OSM for Indian cities).
# Needs "Maps JavaScript API" + "Geocoding API" + "Places API" enabled on the key.
# Optional: the app falls back to the free OSM/Nominatim backend if this is blank.
VITE_GOOGLE_MAPS_KEY=
